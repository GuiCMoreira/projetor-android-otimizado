# Copie para keystore.properties (que fica fora do git) e preencha com a sua chave.
# Criar a chave: keytool -genkeypair -v -keystore inicio.jks -alias inicio -keyalg RSA -keysize 2048 -validity 10000
storeFile=inicio.jks
storePassword=troque-esta-senha
keyAlias=inicio
keyPassword=troque-esta-senha
