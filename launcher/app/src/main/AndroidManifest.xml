<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 1.1: widget de clima (Open-Meteo) e detecção da cidade na primeira vez. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 1.2: ler a lista "Ver a seguir" que os apps de streaming publicam (nível normal, sem pedido na tela). -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Sem esta (confirmada na tela uma vez), o Android só mostra a cada app o que ele mesmo publicou. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Central de Controle > Liberar memória: fecha só apps parados (nível normal, sem pedido na tela). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Visibilidade de pacotes sem QUERY_ALL_PACKAGES: só apps abríveis e as telas do fabricante. -->
    <queries>
        <provider android:authorities="android.media.tv" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.zhiying.settings" />
        <package android:name="com.zhiying.autofocus" />
        <package android:name="com.newlink.source" />
        <package android:name="com.android.tv" />
        <package android:name="com.android.tv.settings" />
        <package android:name="com.android.vending" />
        <package android:name="com.zeasn.launcher.projector" />
        <!-- Ações usadas pelos atalhos: continuam visíveis mesmo se uma atualização mudar o pacote que as atende. -->
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOURCE" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DATE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.PROJECTION" /></intent>
        <intent><action android:name="android.intent.action.FOUR_POINT" /></intent>
        <intent><action android:name="android.intent.action.Scale" /></intent>
        <intent><action android:name="com.zhiying.PICTUREMODE" /></intent>
        <intent><action android:name="com.zhiying.AUTO_FOCUS" /></intent>
        <intent><action android:name="android.settings.OTHER_SETTINGS" /></intent>
    </queries>

    <application
        android:name=".InicioApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Inicio">

        <activity
            android:name=".home.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- A tela intermediária do fabricante (com.newlink.provision/.FallbackHome) abre o launcher escolhido
                 procurando MAIN + LAUNCHER no pacote; sem esta entrada ela volta para o launcher de fábrica. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".apps.AllAppsActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".settings.DockEditorActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".settings.WallpaperActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity
            android:name=".settings.CityActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan|stateVisible" />
        <!-- Emergência: aberta pela tela inicial depois de 3 quedas em 5 minutos. -->
        <activity
            android:name=".rescue.RescueActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
